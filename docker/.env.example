# Compose-level variables for docker/compose.example.yml.
# Copy to docker/.env (git-ignored). Compose reads this file only to fill ${...} in
# the compose file; nothing here is passed to Scriptorium itself (that is
# scriptorium.env). Generate secrets on the Docker host; never commit them.

# ---- Scriptorium ----

# Host address the scriptorium (:8480) and keycloak (:8481) ports are published on.
# 127.0.0.1 when the reverse proxy runs on this host (it joins the `proxy` network);
# otherwise an address of this host that only the proxy can reach, e.g. 192.0.2.10.
SCRIPTORIUM_PUBLISH_ADDR=127.0.0.1

# Host path bind-mounted at /data. Local POSIX filesystem only (no NFS/SMB/FUSE).
SCRIPTORIUM_HOST_DATA_DIR=/srv/scriptorium/data
# Host snapshot directory for SCRIPTORIUM_SNAPSHOT_STRATEGY=host (uncomment the
# mount in compose.yml as well).
#SCRIPTORIUM_HOST_SNAPSHOT_DIR=/srv/scriptorium/data/.zfs/snapshot

# Name of the network shared with a reverse proxy on this host.
#SCRIPTORIUM_PROXY_NETWORK=scriptorium-proxy

# ---- Keycloak profile only (`--profile keycloak`) ----

# Public base URL of Keycloak. Also substituted into the realm's frontend URL at
# import, so the issuer becomes ${KC_HOSTNAME}/realms/scriptorium — which must equal
# SCRIPTORIUM_OIDC_ISSUER in scriptorium.env.
KC_HOSTNAME=https://auth.example.com
# Where the admin console is reached; never the public hostname. The default is the
# published port on loopback (use an SSH tunnel), or e.g. http://192.0.2.10:8481.
KC_HOSTNAME_ADMIN=http://127.0.0.1:8481
# Addresses whose X-Forwarded-* headers Keycloak believes: Docker bridge ranges and
# loopback by default; add or substitute the proxy's address when it runs elsewhere.
KC_PROXY_TRUSTED_ADDRESSES=127.0.0.1,172.16.0.0/12

# Audience the realm adds to every access token. Must equal SCRIPTORIUM_OIDC_AUDIENCE
# (default SCRIPTORIUM_PUBLIC_URL) byte for byte.
SCRIPTORIUM_AUDIENCE=https://mcp.example.com/mcp

# PostgreSQL password for Keycloak. Generate: openssl rand -base64 32 | tr -d '/+='
KEYCLOAK_DB_PASSWORD=
# Host path for the Keycloak database (local filesystem; back it up).
KEYCLOAK_HOST_DB_DIR=/srv/scriptorium/keycloak-db

# Temporary master-realm admin, created on first start only. After creating a
# permanent admin (docker/keycloak/README.md), empty both values.
# Generate the password: openssl rand -base64 24 | tr -d '/+='
KC_BOOTSTRAP_ADMIN_USERNAME=bootstrap-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=
