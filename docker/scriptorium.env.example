# Scriptorium configuration (Architecture §12). Copy to docker/scriptorium.env
# (git-ignored) and edit. Read by both the `scriptorium` and `scriptorium-worker`
# services. Any secret may be given as <NAME>_FILE pointing at a file instead.
# Commented lines show the documented default.

# ---- Required ----

# Byte-exact public URL of the MCP endpoint, no trailing slash. It is the OAuth
# `resource`, the default audience, and what users type into Claude.
SCRIPTORIUM_PUBLIC_URL=https://mcp.example.com/mcp

# OIDC issuer (§5.2). With the keycloak profile: ${KC_HOSTNAME}/realms/scriptorium.
SCRIPTORIUM_OIDC_ISSUER=https://auth.example.com/realms/scriptorium
# Value that must appear in the token's `aud` (default: SCRIPTORIUM_PUBLIC_URL).
# With the keycloak profile it must equal SCRIPTORIUM_AUDIENCE in docker/.env.
SCRIPTORIUM_OIDC_AUDIENCE=https://mcp.example.com/mcp
# Admin gating: claim path and value (the reference realm's role).
SCRIPTORIUM_OIDC_ADMIN_CLAIM=realm_access.roles
SCRIPTORIUM_OIDC_ADMIN_VALUE=scriptorium-admin
# Comma-separated `sub` values or emails (emails match only when email_verified is
# true). THE SERVER REFUSES TO START WHILE THIS IS EMPTY, unless
# SCRIPTORIUM_ALLOW_ALL_ISSUER_USERS=true is set explicitly.
SCRIPTORIUM_OIDC_ALLOWED_USERS=
#SCRIPTORIUM_ALLOW_ALL_ISSUER_USERS=false
# The identity claim must be immutable at the issuer. Anything but `sub` (e.g. Entra
# ID's `oid`) also needs SCRIPTORIUM_OIDC_UNSAFE_USER_CLAIM=true; `email` is accepted
# only when email_verified is true, and is compared case-insensitively.
#SCRIPTORIUM_OIDC_USER_CLAIM=sub
#SCRIPTORIUM_OIDC_UNSAFE_USER_CLAIM=false
#SCRIPTORIUM_OIDC_NAME_CLAIM=preferred_username

# MultiFernet master keys, from the compose secret (outside /data). Generate with
# `scriptorium gen-master-key`. Never put the key itself in this file.
SCRIPTORIUM_MASTER_KEYS_FILE=/run/secrets/scriptorium_master_keys

# ---- Network ----

#SCRIPTORIUM_BIND=0.0.0.0:8000
# Addresses whose X-Forwarded-For/-Proto are believed. Default: Docker bridge ranges
# (a proxy on this host). When the proxy runs on another machine, set its address,
# e.g. 192.0.2.20 (if Docker's userland proxy rewrites the source, the bridge
# gateway instead).
#SCRIPTORIUM_TRUSTED_PROXIES=192.0.2.20
# Prometheus metrics; never published through the proxy or as a host port.
#SCRIPTORIUM_METRICS_BIND=0.0.0.0:9100

# ---- Storage and sync ----

#SCRIPTORIUM_DATA_DIR=/data
#SCRIPTORIUM_POLL_SECONDS=600
#SCRIPTORIUM_SYNC_CONCURRENCY=2
#SCRIPTORIUM_SYNC_WORKERS=4
#SCRIPTORIUM_RENDER_WORKERS=2
# Mass-delete circuit breaker (§7).
#SCRIPTORIUM_TOMBSTONE_MAX_PER_POLL=50
# Eligibility for manual blob GC only; nothing is deleted automatically.
#SCRIPTORIUM_BLOB_RETENTION_DAYS=365
#SCRIPTORIUM_DEFAULT_QUOTA_GB=20

# ---- OCR (§8) ----

# Server-wide Claude API key; prefer the _FILE form with a compose secret.
#SCRIPTORIUM_ANTHROPIC_API_KEY_FILE=/run/secrets/anthropic_api_key
# Users allowed to spend the server key (comma-separated ids/emails). Empty = nobody.
#SCRIPTORIUM_SERVER_KEY_USERS=
#SCRIPTORIUM_OCR_MODEL=claude-sonnet-5-5
#SCRIPTORIUM_OCR_MONTHLY_CAP_USD=20
#SCRIPTORIUM_OCR_USER_MONTHLY_CAP_USD=10
# Default: the list price of SCRIPTORIUM_OCR_MODEL.
#SCRIPTORIUM_OCR_PRICE_IN_PER_MTOK=
#SCRIPTORIUM_OCR_PRICE_OUT_PER_MTOK=

# ---- Push (§9) ----

#SCRIPTORIUM_MAX_INLINE_KB=256
#SCRIPTORIUM_MAX_FETCH_MB=50
# Host suffixes fetched without per-fetch confirmation. Empty = always confirm.
#SCRIPTORIUM_PUSH_URL_ALLOWLIST=
# Ink sidecar (`--profile ink`); push_ink is hidden while unset.
#SCRIPTORIUM_INK_SIDECAR_URL=http://scriptorium-ink:9000

# ---- Backup (§10) ----

# host | restic | none
#SCRIPTORIUM_SNAPSHOT_STRATEGY=none
#SCRIPTORIUM_RESTIC_REPO=
#SCRIPTORIUM_RESTIC_PASSWORD_FILE=/run/secrets/restic_password

# ---- Operations ----

#SCRIPTORIUM_AUDIT_RETENTION_DAYS=365
#SCRIPTORIUM_LOG_LEVEL=info
