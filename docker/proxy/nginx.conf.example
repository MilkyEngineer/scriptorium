# Scriptorium — nginx reverse-proxy example (Architecture §13 per-path table).
#
# Include from the `http {}` block (e.g. /etc/nginx/conf.d/scriptorium.conf).
# Needs nginx >= 1.27.3 for upstream variant (a) below (`resolve`), >= 1.25.1
# otherwise (`http2 on;`). Replace example.com names and the RFC 5737
# addresses (192.0.2.0/24, 198.51.100.0/24, 203.0.113.0/24) with your own.
#
# TLS via ACME with certbot (webroot), for example:
#   certbot certonly --webroot -w /var/www/certbot -d mcp.example.com -d auth.example.com
# Renewal runs from certbot's timer; reload nginx afterwards (--deploy-hook "nginx -s reload").

# ---------------------------------------------------------------------------
# Upstreams
# ---------------------------------------------------------------------------

# (a) nginx runs in a container on the Docker host, attached to the `proxy` network.
#     Names are resolved through Docker's embedded DNS and re-resolved at runtime
#     (`resolve`, open-source nginx >= 1.27.3), so recreating a container does not
#     leave nginx pointing at a stale address, and nginx still starts while the
#     keycloak profile is not running.
upstream scriptorium_upstream {
    zone scriptorium_upstream 64k;
    resolver 127.0.0.11 valid=10s ipv6=off;
    server scriptorium:8000 resolve;
    keepalive 16;
}
upstream keycloak_upstream {
    zone keycloak_upstream 64k;
    resolver 127.0.0.11 valid=10s ipv6=off;
    server keycloak:8080 resolve;
    keepalive 8;
}

# (b) nginx runs on another machine: use the ports the compose file publishes on
#     SCRIPTORIUM_PUBLISH_ADDR (here 192.0.2.10), and set SCRIPTORIUM_TRUSTED_PROXIES
#     and KC_PROXY_TRUSTED_ADDRESSES to this machine's address.
# upstream scriptorium_upstream {
#     server 192.0.2.10:8480;
#     keepalive 16;
# }
# upstream keycloak_upstream {
#     server 192.0.2.10:8481;
#     keepalive 8;
# }

# ---------------------------------------------------------------------------
# Client address and allowlists
# ---------------------------------------------------------------------------

# The address forwarded upstream. We are the edge, so X-Forwarded-For is SET to the
# connecting address, never appended to a client-supplied value.
map $remote_addr $scriptorium_client_ip {
    default $remote_addr;
}

# Optional Cloudflare (proxied DNS) variant. Trust CF-Connecting-IP only when the TLS
# connection itself proves it came from Cloudflare (Authenticated Origin Pulls):
# enable the ssl_client_certificate / ssl_verify_client lines in both TLS servers
# below and replace the map above with this one.
# map $ssl_client_verify $scriptorium_client_ip {
#     SUCCESS $http_cf_connecting_ip;
#     default $remote_addr;
# }

# Who may reach the Keycloak admin console / master realm through the public host
# (§13 says: nobody; the console lives on KC_HOSTNAME_ADMIN). Keep a LAN/admin CIDR
# here only if you really need it.
geo $scriptorium_client_ip $keycloak_admin_allowed {
    default        0;
    198.51.100.0/24 1;   # admin LAN / VPN (example)
}

# Monitoring sources allowed to call /healthz.
geo $scriptorium_client_ip $healthz_allowed {
    default        0;
    127.0.0.1      1;
    198.51.100.0/24 1;   # monitoring host(s) (example)
}

# OPTIONAL defence in depth for /mcp (§13): bearer auth is the real control. If you
# enable it, include every network Claude Code runs from, or Claude Code breaks.
geo $scriptorium_client_ip $mcp_allowed {
    default        1;    # set to 0 to enforce the list below
    160.79.104.0/21 1;   # Anthropic egress (claude.ai, Desktop, mobile)
    203.0.113.0/24  1;   # users' networks / VPN range (example)
}

limit_req_zone $scriptorium_client_ip zone=scriptorium_mcp:10m  rate=20r/s;
limit_req_zone $scriptorium_client_ip zone=scriptorium_dl:10m   rate=2r/s;
limit_req_zone $scriptorium_client_ip zone=keycloak_auth:10m    rate=10r/s;
limit_req_status 429;

# ---------------------------------------------------------------------------
# Port 80: ACME http-01 challenges and redirect to HTTPS
# ---------------------------------------------------------------------------

server {
    listen 80;
    listen [::]:80;
    server_name mcp.example.com auth.example.com;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

# ---------------------------------------------------------------------------
# mcp.example.com — Scriptorium
# ---------------------------------------------------------------------------

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name mcp.example.com;

    ssl_certificate     /etc/letsencrypt/live/mcp.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mcp.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    # Cloudflare Authenticated Origin Pulls (see the map above):
    # ssl_client_certificate /etc/nginx/cloudflare-origin-pull-ca.pem;
    # ssl_verify_client on;

    add_header Strict-Transport-Security "max-age=31536000" always;

    client_max_body_size 64m;   # push_* payloads; Scriptorium enforces its own caps

    # Set once at server level. nginx drops ALL inherited proxy_set_header lines in
    # a location that defines any of its own, so locations below define none.
    proxy_http_version 1.1;
    proxy_set_header Connection        "";
    proxy_set_header Host              $host;
    proxy_set_header X-Forwarded-For   $scriptorium_client_ip;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $host;
    proxy_set_header X-Forwarded-Port  $server_port;
    proxy_set_header Forwarded         "";
    proxy_set_header X-Real-IP         "";

    # Streamable HTTP MCP endpoint: stream responses (SSE) as they are produced.
    location = /mcp {
        if ($mcp_allowed = 0) { return 403; }
        limit_req zone=scriptorium_mcp burst=40 nodelay;
        proxy_pass http://scriptorium_upstream;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;   # >= 100 s; long-lived SSE streams
        proxy_send_timeout 300s;
    }
    location /mcp/ {
        if ($mcp_allowed = 0) { return 403; }
        limit_req zone=scriptorium_mcp burst=40 nodelay;
        proxy_pass http://scriptorium_upstream;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 300s;
    }

    # Protected-resource metadata (RFC 9728) and anything else Scriptorium serves
    # under /.well-known/.
    location ^~ /.well-known/ {
        if ($mcp_allowed = 0) { return 403; }
        limit_req zone=scriptorium_mcp burst=20 nodelay;
        proxy_pass http://scriptorium_upstream;
    }

    # Signed downloads for users' browsers: unguessable 10-minute tokens, rate-limited.
    location ^~ /dl/ {
        limit_req zone=scriptorium_dl burst=10 nodelay;
        proxy_pass http://scriptorium_upstream;
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    # Proxy / monitoring only.
    location = /healthz {
        if ($healthz_allowed = 0) { return 403; }
        proxy_pass http://scriptorium_upstream;
    }

    # Nothing else is public (metrics live on :9100 and are never proxied).
    location / {
        return 404;
    }
}

# ---------------------------------------------------------------------------
# auth.example.com — Keycloak (only with the `keycloak` compose profile)
# ---------------------------------------------------------------------------

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name auth.example.com;

    ssl_certificate     /etc/letsencrypt/live/auth.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/auth.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    # ssl_client_certificate /etc/nginx/cloudflare-origin-pull-ca.pem;
    # ssl_verify_client on;

    add_header Strict-Transport-Security "max-age=31536000" always;

    # Keycloak's session cookies and redirect URLs are large: room for big request
    # headers from browsers and big response headers from Keycloak.
    large_client_header_buffers 4 32k;
    proxy_buffer_size       128k;
    proxy_buffers           4 256k;
    proxy_busy_buffers_size 256k;

    proxy_http_version 1.1;
    proxy_set_header Connection        "";
    proxy_set_header Host              $host;
    proxy_set_header X-Forwarded-For   $scriptorium_client_ip;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $host;
    proxy_set_header X-Forwarded-Port  $server_port;
    proxy_set_header Forwarded         "";

    # Admin console and the master realm: deny from the internet (§5.3, §13). The
    # console is reached on KC_HOSTNAME_ADMIN instead.
    location ^~ /admin/ {
        if ($keycloak_admin_allowed = 0) { return 403; }
        proxy_pass http://keycloak_upstream;
    }
    location = /admin {
        if ($keycloak_admin_allowed = 0) { return 403; }
        proxy_pass http://keycloak_upstream;
    }
    location ^~ /realms/master/ {
        if ($keycloak_admin_allowed = 0) { return 403; }
        proxy_pass http://keycloak_upstream;
    }

    # Clients are pre-registered; no dynamic client registration from outside.
    location ^~ /realms/scriptorium/clients-registrations/ {
        return 403;
    }

    # Public realm endpoints: OIDC protocol (authorize, token, certs, userinfo,
    # logout), login actions (login form, required actions, email links), identity
    # brokering (login + endpoint), discovery.
    location ~ ^/realms/scriptorium/(protocol/openid-connect/|login-actions/|broker/[^/]+/(endpoint|login)|\.well-known/) {
        limit_req zone=keycloak_auth burst=40 nodelay;
        proxy_pass http://keycloak_upstream;
    }
    # Optional: the account console, if users should manage their own password/2FA.
    # location ^~ /realms/scriptorium/account { proxy_pass http://keycloak_upstream; }

    # Theme and static assets.
    location ^~ /resources/ {
        proxy_pass http://keycloak_upstream;
    }

    # RFC 8414 metadata for the path-based issuer:
    # /.well-known/oauth-authorization-server/realms/scriptorium
    location ^~ /.well-known/ {
        limit_req zone=keycloak_auth burst=20 nodelay;
        proxy_pass http://keycloak_upstream;
    }

    # Everything else (/, /realms/<other>, /health, /metrics): not exposed.
    location / {
        return 404;
    }
}
